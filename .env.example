# === Supabase (Required) ===
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === QQ Email ===
QQ_EMAIL=your-email@qq.com
QQ_EMAIL_AUTH_CODE=your-auth-code

# === AI Model Configuration ===
# Provider: ollama-gemma4 | ollama-qwen3 | deepseek | gemini | qwen | zhipu
LLM_PROVIDER=ollama-gemma4

# Ollama (local, no API key needed)
# LLM_PROVIDER=ollama-gemma4
# Install: https://ollama.com/download
# Pull model: ollama pull gemma4:e4b

# DeepSeek API
# LLM_PROVIDER=deepseek
# LLM_API_KEY=your-deepseek-api-key

# Google Gemini API
# LLM_PROVIDER=gemini
# LLM_API_KEY=your-gemini-api-key

# Qwen API (Alibaba Cloud)
# LLM_PROVIDER=qwen
# LLM_API_KEY=your-dashscope-api-key

# Zhipu GLM API
# LLM_PROVIDER=zhipu
# LLM_API_KEY=your-zhipu-api-key

# Custom OpenAI-compatible provider (advanced)
# LLM_TYPE=openai-compatible
# LLM_API_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=your-api-key
# LLM_MODEL=gemma4:e4b
# LLM_BATCH_SIZE=15
# LLM_SUPPORTS_JSON=false

# === Security ===
CRON_SECRET=your-cron-secret
API_SECRET=your-api-secret

# === Optional ===
GITHUB_TOKEN=
HF_PROXY_URL=
NEXT_PUBLIC_BASE_URL=
